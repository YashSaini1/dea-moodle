{{!
    @template block_sql_myoverview/course-action-menu

    This template renders action menu for each course.

    Example context (json):
    {
        "isfavourite": true
    }
}}
<div class="ml-auto dropdown">
    <button class="btn btn-link btn-icon icon-size-3 coursemenubtn"
        type="button"
        data-toggle="dropdown"
        aria-haspopup="true"
        aria-expanded="false">
        <i class="icon fa fa-ellipsis-v fa-fw m-0" title="{{#str}} aria:courseactions, block_sql_myoverview {{/str}} {{{fullname}}}" aria-hidden="true"></i>
        <span class="sr-only">{{#str}} aria:courseactions, block_sql_myoverview {{/str}} {{{fullname}}}</span>
    </button>
    <div class="dropdown-menu dropdown-menu-right">
        <a class="dropdown-item {{^candeletecourse}}hidden{{/candeletecourse}}" href="/course/delete.php?id={{id}}"
            data-action="delete-course"
            data-course-id="{{id}}"
            aria-controls="favorite-icon-{{ id }}-{{ uniqid }}"
            >
            {{#str}} deletecourse, block_sql_myoverview {{/str}}
            <div class="sr-only">
                {{#str}} aria:deletecourse, block_sql_myoverview {{/str}}
            </div>
        </a>
    </div>
</div>
