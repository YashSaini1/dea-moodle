{{!
    @template block_sql_myoverview/progress-bar

    This template renders a simple progress bar.

    Example context (json):
    {
        "progress": 50
    }
}}
<div class="progress-text">
    <span class="sr-only">{{#str}}aria:courseprogress, block_sql_myoverview{{/str}}</span>
    <div>
        <p class="progress-text-modules"><span>{{completionmodules}}</span> / {{allmodules}} Modules</p>
        <p class="progress-text-percentages">
            {{#str}}completepercent, block_sql_myoverview, <span>{{progress}}</span>{{/str}}
        </p>
    </div>
    <progress value="{{completionmodules}}" max="{{allmodules}}"></progress>
</div>
