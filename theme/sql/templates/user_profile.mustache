{{!
    @template theme_boost/login

    Login page template

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Login page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headers keep HTML validators happy</h1>"
        }
    }
}}
<div class="user-profile">
    <div class="header_container">
        <h1 class="user-profile-title">
            {{fullname}}
        </h1>
        {{{user_tier_buttons}}}
    </div>
    <div class="user-profile-counter">
        {{{ carma_points }}}
        {{> theme_sql/date_time }}
    </div>
    <div class="user-profile-wrapper">
        <div class="user-details">
            <h4 class="user-profile-subtitle">{{#str}}user_details, theme_sql{{/str}}</h4>
            <div class="profile-user-details">
                <div class="profile-picture">
                    {{{picture}}}
                </div>
                <div class="profile-user-details-fields">
                    {{#profile_fields}}
                        {{#value}}<div class="profile-field field-{{value}}">
                            <span class="profile-field-name">{{name}}</span>
                            <span class="profile-field-value">{{value}}</span>
                        </div>{{/value}}
                    {{/profile_fields}}
                </div>
            </div>
            <div class="profile-btn-wrapper">
                {{#editurl}}
                    <div>
                        <a class="profile-button button-edit" href="{{editurl}}"> Edit profile</a>
                    </div>
                {{/editurl}}
                {{#changepasswordurl}}
                    <div>
                        <a class="profile-button button-change-password" href="{{changepasswordurl}}"> Change password</a>
                    </div>
                {{/changepasswordurl}}
            </div>
        </div>
        {{#tier_info}}
            {{{tier_info}}}
        {{/tier_info}}
    </div>
</div>
{{#ref_info_display}}
<section id="ref" class="referral">
    <div class="referral__wrapper">
        <div class="referral__main">
            <h4>Referral program</h4>

            <p>Your unique referral link</p>

            <div class="referral__main_link">
                <input type="text" id="input-url" value="{{ref_link}}" readonly>
                <button id="copy-button">Copy</button>
            </div>

            <a href="{{ref_info_link}}">Learn about program</a>
        </div>

        <div class="referral__stats">
            <div class="referral__stats_credits">
                <p>Credits earned</p>
                <h4>{{balance}}</h4>
                <p>Rewards or credits will be applied to your account within a specified time frame after the referral purchase.</p>
            </div>

            <div class="referral__stats_stat-wrapper">
                <div class="referral__stats_stat">
                    <div class="referral__stats_stat_counter">
                        <p>Friends registered</p>
                        <p>{{friends_registered}}</p>
                    </div>

                    <div class="referral__stats_stat_counter">
                        <p>Plans purchased</p>
                        <p>{{plans_purchased}}</p>
                    </div>
                </div>
                <a class="pop-up-btn"><span>Withdraw</span></a>
            </div>
        </div>
    </div>
</section>
<section id="1" class="benefits">
    <div class="benefits__wrapper">
        <div class="benefits__program">
            <h4>Program benefits</h4>

            <div class="benefits__program_description">
                <div class="benefits__program_description_for-you for-person">
                    <h4>For you</h4>

                    <p>Earn exclusive discounts, credits, or even cash rewards for each successful referral.</p>
                </div>

                <div class="benefits__program_description_for-friend for-person">
                    <h4>For your friend</h4>

                    <p>They get a welcome discount on their first purchase, making it a win-win situation.</p>
                </div>
            </div>
        </div>

        <div class="benefits__cards">
            <div class="benefits__cards_card">
                <div class="benefits__cards_card_heading">
                    <h4>
                        Self-paced bootcamp rewards
                    </h4>
                </div>

                <div class="benefits__cards_card_for-you for-person">
                    <h4>For you</h4>

                    <p>Earn exclusive discounts, credits, or even cash rewards for each successful referral.</p>
                </div>

                <div class="benefits__cards_card_points-wrapper">
                    <div class="benefits__cards_card_points">
                        <div class="benefits__cards_card_points_point orange">
                            <p>1st referral</p>

                            <p><strong>$250</strong></p>
                        </div>

                        <div class="benefits__cards_card_points_point orange">
                            <p>2nd referral</p>

                            <p><strong>$300</strong></p>
                        </div>

                        <div class="benefits__cards_card_points_point orange">
                            <p>3+ referrals</p>

                            <p><strong>$350 each</strong></p>
                        </div>
                    </div>
                </div>

                <div class="benefits__cards_card_for-friend for-person">
                    <h4>For your friend</h4>

                    <p>They get a welcome discount on their first purchase, making it a win-win situation.</p>
                </div>

                <p>Your friend receives <strong>$250 off</strong> their Bootcamp enrollment.</p>
            </div>

            <div class="benefits__cards_card">
                <div class="benefits__cards_card_heading" style="margin-bottom: 0.5rem;">
                    <h4 style="margin-bottom: 0">
                        Personalized Training Rewards<span style="font-size: 14px; display: block; margin-top: 0.25rem;"></span>
                        <br>
                    </h4>
                    <a href="https://dataengineeracademy.com/?clickButton=true" target="_blank">Book a call</a>
                </div>

                <div class="benefits__cards_card_for-you for-person">
                    <h4>For you</h4>

                    <p>Earn exclusive discounts, credits, or even cash rewards for each successful referral.</p>
                </div>

                <div class="benefits__cards_card_points-wrapper">
                    <div class="benefits__cards_card_points">
                        <div class="benefits__cards_card_points_point blue">
                            <p>1st referral</p>

                            <p><strong>$1,000</strong> referral bonus</p>
                        </div>
                    </div>
                </div>

                <div class="benefits__cards_card_for-friend for-person">
                    <h4>For your friend</h4>

                    <p>They get a welcome discount on their first purchase, making it a win-win situation.</p>
                </div>

                <p>Your referral will receive <strong>$1,000</strong> off their new membership!</p>
            </div>
        </div>
    </div>
</section>

<div class="withdraw">
    <div class="withdraw__wrapper">
        <span class="withdraw__wrapper_close-button pop-up-btn"></span>
        <div class="withdraw__top">
            <div class="withdraw__top_heading">
                <h2>Withdraw via PayPal</h2>

                <h3>Withdraw via PayPal</h3>

                <p>Enter the email address linked to your PayPal account. Make sure this email is registered with PayPal
                    to
                    successfully receive your funds.</p>
            </div>

            <div class="withdraw__top_email">
                <p>Email</p>

                <input type="email" id="email" value="{{email}}" placeholder="Enter your email" required/>
            </div>

            <div class="withdraw__top_balance">
                <p>Balance</p>

                <div class="withdraw__top_balance_payment">
                    <input type="number" id="amount" required/>

                    <div class="withdraw__top_balance_payment_money">
                        <p>Available balance</p>

                        <p class="balance">{{balance}}</p>

                        <div class="withdraw__top_balance_payment_money_selectall selectAll">Select all</div>
                    </div>

                    <div class="message"></div>
                </div>
                <svg class="loading-spinner" viewBox="0 0 50 50">
                    <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                </svg>
                <div class="confirmation">
                    <input type="checkbox" id="confirmationCheckbox" />
                    <label for="confirmationCheckbox">I confirm the correctness of the entered data</label>
                </div>
            </div>

            <button class="withdraw__top_button" id="sendPaymentButton" disabled><span>Withdraw</span></button>
        </div>

        <div class="withdraw__history">
            <h4>Withdrawal History</h4>

            <div class="withdraw__history_info">
                <table id="payment-history" class="withdraw__history_info_table">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Used email</th>
                        <th>Balance</th>
                        <th>Date & time</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="dark-bg"></div>
{{/ref_info_display}}